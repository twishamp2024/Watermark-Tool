<?xml version="1.0" encoding="utf-8"?>
<!-- Presets and settings are worth backing up; in-flight batch files and caches are not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
